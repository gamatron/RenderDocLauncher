<idea-plugin version="2">
	<id>RenderDocLauncher</id>
	<name>RenderDoc Launcher</name>

	<vendor url="https://github.com/gamatron/RenderDocLauncher" email="vojta.krasa@gmail.com">Vojtech
		Krasa
	</vendor>

	<description><![CDATA[
     <a href="https://renderdoc.org/">RenderDoc</a> integration.<br/>
     Use buttons from the main toolbar to start RenderDoc along with executed application,
     or button next to the console window of already started application.                    
        <br> <br>
        <a href="https://github.com/gamatron/RenderDocLauncher/">GitHub</a> | <a href="https://github.com/gamatron/RenderDocLauncher/issues">Issues</a>
      ]]></description>


	<project-components>
	</project-components>

	<actions>
		<action
				id="krasa.renderdoc.action.StartRenderDocMainToolbarAction"
				class="krasa.renderdoc.action.StartRenderDocMainToolbarAction"
				icon="/krasa/renderdoc/svg/console16.svg"
				text="Start RenderDoc"
				description="Start RenderDoc with selectable JDK">
			<add-to-group group-id="MainToolBar" anchor="last"/>
		</action>
		<!--		<action-->
		<!--				id="krasa.renderdoc.action.FocusRenderDocAction"-->
		<!--				class="krasa.renderdoc.action.FocusRenderDocAction"-->
		<!--				icon="/krasa/renderdoc/svg/console16.svg"-->
		<!--				text="FocusRenderDocAction"-->
		<!--				description="xxx">-->
		<!--			<add-to-group group-id="MainToolBar" anchor="last"/>-->
		<!--		</action>-->
	</actions>

	<extensions defaultExtensionNs="com.intellij">
		<notificationGroup id="RenderDocLauncher" displayType="BALLOON" isLogByDefault="true"/>

		<executor implementation="krasa.renderdoc.executor.RunRenderDocExecutor"/>
		<programRunner implementation="krasa.renderdoc.runner.RunRenderDocRunner"/>
		<programRunner implementation="krasa.renderdoc.runner.DebugRenderDocRunner"/>
		<executor implementation="krasa.renderdoc.executor.DebugRenderDocExecutor"/>
		<java.programPatcher implementation="krasa.renderdoc.integration.RenderDocJavaProgramPatcher"/>
		<consoleActionsPostProcessor implementation="krasa.renderdoc.integration.RenderDocConsoleActionsPostProcessor"/>
		<applicationConfigurable instance="krasa.renderdoc.MyConfigurable" id="RenderDocLauncher"
								 displayName="RenderDoc Launcher"/>
		<applicationService serviceImplementation="krasa.renderdoc.ApplicationSettingsService"/>
	</extensions>

	<depends>com.intellij.modules.java</depends>

</idea-plugin>